# Publish only the reproducible experiment and its saved evidence.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/run_experiment.py
!/plot_results.py
!/data/
!/results/
!/figures/
!/validation/

/data/*
!/data/SOURCE.md
!/data/email-Eu-core.txt
!/data/email-Eu-core-department-labels.txt

/results/*
!/results/*.csv
!/results/experiment_config.json
!/results/network_audit.json

/figures/*
!/figures/*.png
!/figures/*.pdf

/validation/*
!/validation/audit_diffusion_independent.py
!/validation/validation_result.txt

# Local environments, credentials, editor files, and generated caches.
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
~$*
*.docx
*.doc
